{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/serie.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        },
        {
          "key": "Content-Encoding",
          "value": "gzip"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/serie.json",
      "destination": "https://iuopzrxfmobllhkyuvkk.supabase.co/storage/v1/object/public/tela/dados.json.gz"
    },
    {
      "source": "/dados.json.gz",
      "destination": "https://iuopzrxfmobllhkyuvkk.supabase.co/storage/v1/object/public/tela/dados.json.gz"
    }
  ],
  "outputDirectory": "site"
}
