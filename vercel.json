{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/dados.json.gz",
      "destination": "https://iuopzrxfmobllhkyuvkk.supabase.co/storage/v1/object/public/tela/dados.json.gz"
    }
  ],
  "outputDirectory": "site"
}
